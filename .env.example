# Datenbank
DB_USER=eeg
DB_PASSWORD=change-this-password
DB_NAME=eeg_platform

# Domain (ohne https://) -- wird für Traefik-Routing verwendet (Host(`${DOMAIN}`) etc.)
DOMAIN=deine-domain.at

# App
APP_SECRET=change-this-to-a-random-64-char-string

# latex-service
LATEX_API_KEY=change-this-api-key

# E-Mail (Brevo, Postmark, ... -- optional, kann leer bleiben und später über
# Platform-Admin -> E-Mail-Einstellungen per Microsoft Graph konfiguriert werden)
SMTP_HOST=smtp-relay.brevo.com
SMTP_USER=
SMTP_PASSWORD=

# MQTT (Mosquitto) -- Zugangsdaten für ESP32-Ausleseeinheiten und den internen
# mqtt-subscriber. Bewusst LEER hier -- wird automatisch von scripts/mqtt_secure_setup.sh
# mit einem zufälligen Passwort befüllt, nicht von Hand eintragen (ein leeres Feld ist das
# Signal fürs Skript, dass noch keine Zugangsdaten generiert wurden).
MQTT_USER=
MQTT_PASSWORD=

# Redis (Session-Speicher + Login-Rate-Limiting) -- bewusst LEER hier, siehe
# scripts/redis_secure_setup.sh (gleiches Muster wie MQTT oben: wird automatisch befüllt).
REDIS_PASSWORD=

# Eingeschränkte Datenbank-Rolle für Webapp/mqtt-subscriber/eda-parser zur Laufzeit (NICHT der
# Schema-Besitzer oben) -- siehe scripts/db_runtime_role_setup.sh. Bewusst LEER hier, wird
# automatisch generiert.
APP_DB_USER=
APP_DB_PASSWORD=
